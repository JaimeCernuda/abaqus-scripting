  EL_GROUP = ALL_ELEMENTS
  GROUP_OPER = SUM
  LC_SET = ALL, 1, ALL
END_
! ----------------------------------------------------------------
! 
! Design Response: DR_Volume
! 
DRESP
  ID_NAME = DR_Volume
  LIST = NO_LIST
  DEF_TYPE = SYSTEM
  TYPE = VOLUME
  EL_GROUP = ALL_ELEMENTS
  GROUP_OPER = SUM
END_
! ----------------------------------------------------------------
! 
! Design area for task: TopOpt
! 
DV_TOPO
  ID_NAME = TopOpt_DESIGN_AREA_
  EL_GROUP = ALL_ELEMENTS
END_
! ----------------------------------------------------------------
! 
! Objective Function: MinStrainEnergy
! 
OBJ_FUNC
  ID_NAME = MinStrainEnergy
  DRESP = DR_StrainEnergy, 1.
  TARGET = MIN
END_
! ----------------------------------------------------------------
! 
! Constraint: VolumeConstraint
! 
CONSTRAINT
  ID_NAME = VolumeConstraint
  DRESP = DR_Volume
  MAGNITUDE = REL
  LE_VALUE = 0.5
END_
! ----------------------------------------------------------------
! 
! Geometric Restriction: FrozenBC
! 
DVCON_TOPO
  ID_NAME = FrozenBC
  EL_GROUP = Block-1_FrozenElems
