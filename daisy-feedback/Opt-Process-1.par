END_
OPT_PARAM
  ID_NAME = TopOpt_OPT_PARAM_
  OPTIMIZE = TopOpt
  AUTO_FROZEN = BOTH
  DENSITY_UPDATE = NORMAL
  DENSITY_LOWER = 0.001
  DENSITY_UPPER = 1.
  DENSITY_MOVE = 0.25
  MAT_INTERPOLATION = SIMP
  MAT_PENALTY = 3.
  STOP_CRITERION_LEVEL = BOTH
  STOP_CRITERION_OBJ = 0.001
  STOP_CRITERION_DENSITY = 0.005
  STOP_CRITERION_ITER = 4
  SUM_Q_FACTOR = 6.
END_
STOP
  ID_NAME = TopOpt_GLOBAL_STOP_CONDITION_
  ITER_MAX = 20
END_
DRIVER
driver.Solver.AddCallArgs = ['message', 'messaging_mechanism=DIRECT', 'listener_name=frisco1.wasatch.peaks', 'listener_resource=4081943', 'direct_port=39619',  'memory=90%',]
