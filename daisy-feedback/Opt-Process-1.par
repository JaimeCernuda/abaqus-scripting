! Optimization Process name: Opt-Process-1
! Model name: Model-1
! Task name: TopOpt
! Generated by: Abaqus/CAE 2025
OPTIONS
  DRESP_GROUP_OPER_AGGREGATION = ON
END_
FEM_INPUT
