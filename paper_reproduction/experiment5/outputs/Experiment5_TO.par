! Experiment 5: Topology Optimization Parameter File
! Generated by generate_par_file.py
!
! Objective: Minimize strain energy (maximize stiffness)
! Constraint: Volume <= 40% of original
! Method: SIMP (penalty 3.0)
! Frozen regions: 3 pin hole areas

FEM_INPUT
  ID_NAME                = MY_INPUT_FILES
  FILE                   = Experiment5_FEA.inp
END_

! ---------- Design Responses ----------

DRESP
  ID_NAME                = DRESP_STRAIN_ENERGY
  DEF_TYPE               = SYSTEM
  TYPE                   = STRAIN_ENERGY
  EL_GROUP               = ALL_ELEMENTS
  GROUP_OPER             = SUM
END_

DRESP
  ID_NAME                = DRESP_VOLUME
  DEF_TYPE               = SYSTEM
  TYPE                   = VOLUME
  EL_GROUP               = ALL_ELEMENTS
  GROUP_OPER             = SUM
END_

! ---------- Objective Function ----------

OBJ_FUNC
  ID_NAME                = MIN_STRAIN_ENERGY
  TARGET                 = MIN
  DRESP                  = DRESP_STRAIN_ENERGY
END_

! ---------- Constraints ----------

CONSTRAINT
  ID_NAME                = VOLUME_CONSTRAINT
  DRESP                  = DRESP_VOLUME
  MAGNITUDE              = REL
  LE_VALUE               = 0.4
END_

! ---------- Design Variables ----------

DV_TOPO
  ID_NAME                = DESIGN_AREA
  EL_GROUP               = ALL_ELEMENTS
END_

! ---------- Frozen Regions ----------

GROUP_DEF
  ID_NAME                = ALL_FROZEN
  TYPE                   = ELEM
  FORMAT                 = LIST_GROUP
LIST_BEGIN
FreezeUpperPin, FreezeLowerLeft, FreezeLowerRight
END_

DVCON_TOPO
  ID_NAME                = FROZEN_PINS
  CHECK_TYPE             = FROZEN
  EL_GROUP               = ALL_FROZEN
END_

! ---------- Optimization Task ----------

OPTIMIZE
  ID_NAME                = TOPOLOGY_OPTIMIZATION
  DV                     = DESIGN_AREA
  OBJ_FUNC               = MIN_STRAIN_ENERGY
  CONSTRAINT             = VOLUME_CONSTRAINT
  DVCON                  = FROZEN_PINS
  STRATEGY               = TOPO_SENSITIVITY
END_

OPT_PARAM
  ID_NAME                = OPT_PARAMS
  OPTIMIZE               = TOPOLOGY_OPTIMIZATION
  MAT_INTERPOLATION      = SIMP
  TOPO_FILTER_RADIUS     = 6.0
END_

STOP
  ID_NAME                = GLOBAL_STOP
  ITER_MAX               = 3
END_

SMOOTH
  ID_NAME                = ISO_SMOOTHING
  TASK                   = iso
  ISO_VALUE              = 0.3
  SELF_INTERSECTION_CHECK = runtime
  SMOOTH_CYCLES          = 10
  REDUCTION_RATE         = 60
  REDUCTION_ANGLE        = 5.0
  FORMAT                 = stl
END_
