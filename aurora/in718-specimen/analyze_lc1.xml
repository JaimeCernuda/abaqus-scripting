<ParameterList name="Problem">
  <Parameter name="Physics" type="string" value="Plato Driver"/>
  <Parameter name="Spatial Dimension" type="int" value="3"/>
  <Parameter name="Input Mesh" type="string" value="./mesh.exo"/>

  <ParameterList name="Plato Problem">
    <Parameter name="Physics" type="string" value="Mechanical"/>
    <Parameter name="PDE Constraint" type="string" value="Elliptic"/>
    <Parameter name="Self-Adjoint" type="bool" value="true"/>

    <ParameterList name="Criteria">
      <ParameterList name="Internal Elastic Energy">
        <Parameter name="Type" type="string" value="Scalar Function"/>
        <Parameter name="Scalar Function Type" type="string" value="Internal Elastic Energy"/>
        <ParameterList name="Penalty Function">
          <Parameter name="Type" type="string" value="SIMP"/>
          <Parameter name="Exponent" type="double" value="3.0"/>
          <Parameter name="Minimum Value" type="double" value="1.0e-3"/>
        </ParameterList>
      </ParameterList>
    </ParameterList>

    <ParameterList name="Elliptic">
      <ParameterList name="Penalty Function">
        <Parameter name="Type" type="string" value="SIMP"/>
        <Parameter name="Exponent" type="double" value="3.0"/>
        <Parameter name="Minimum Value" type="double" value="1.0e-3"/>
      </ParameterList>
    </ParameterList>

    <ParameterList name="Spatial Model">
      <ParameterList name="Domains">
        <ParameterList name="Design Volume">
          <Parameter name="Element Block" type="string" value="design_domain"/>
          <Parameter name="Material Model" type="string" value="IN718"/>
        </ParameterList>
      </ParameterList>
    </ParameterList>

    <ParameterList name="Material Models">
      <ParameterList name="IN718">
        <ParameterList name="Isotropic Linear Elastic">
          <Parameter name="Youngs Modulus" type="double" value="200e3"/>
          <Parameter name="Poissons Ratio" type="double" value="0.3"/>
        </ParameterList>
      </ParameterList>
    </ParameterList>

    <!-- LC1: 20 kN downward (-Y) on top face
         Top face area = 64.60 x 25.0 = 1615.0 mm^2
         Traction = 20000 / 1615.0 = 12.384 MPa -->
    <ParameterList name="Natural Boundary Conditions">
      <ParameterList name="Vertical Load">
        <Parameter name="Type" type="string" value="Uniform"/>
        <Parameter name="Values" type="Array(double)" value="{0.0, -12.384, 0.0}"/>
        <Parameter name="Sides" type="string" value="load_upper"/>
      </ParameterList>
    </ParameterList>

    <!-- BCs: lower pin holes fixed in Y and Z (free in X) -->
    <ParameterList name="Essential Boundary Conditions">
      <ParameterList name="Left Pin Y Fixed">
        <Parameter name="Type" type="string" value="Zero Value"/>
        <Parameter name="Index" type="int" value="1"/>
        <Parameter name="Sides" type="string" value="fixed_left_yz"/>
      </ParameterList>
      <ParameterList name="Left Pin Z Fixed">
        <Parameter name="Type" type="string" value="Zero Value"/>
        <Parameter name="Index" type="int" value="2"/>
        <Parameter name="Sides" type="string" value="fixed_left_yz"/>
      </ParameterList>
      <ParameterList name="Left Pin X Fixed">
        <Parameter name="Type" type="string" value="Zero Value"/>
        <Parameter name="Index" type="int" value="0"/>
        <Parameter name="Sides" type="string" value="fixed_left_yz"/>
      </ParameterList>
      <ParameterList name="Right Pin Y Fixed">
        <Parameter name="Type" type="string" value="Zero Value"/>
        <Parameter name="Index" type="int" value="1"/>
        <Parameter name="Sides" type="string" value="fixed_right_yz"/>
      </ParameterList>
      <ParameterList name="Right Pin Z Fixed">
        <Parameter name="Type" type="string" value="Zero Value"/>
        <Parameter name="Index" type="int" value="2"/>
        <Parameter name="Sides" type="string" value="fixed_right_yz"/>
      </ParameterList>
    </ParameterList>

  </ParameterList>
</ParameterList>
